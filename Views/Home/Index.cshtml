@model IEnumerable<TaskListApp.Models.TaskItem>

@{
    ViewData["Title"] = "Список задач";
}

<h1>@ViewData["Title"]</h1>

<!-- Форма фильтрации -->
<form asp-action="Index" method="get" class="form-inline mb-3">
    <div class="form-group mr-2">
        <input type="text" name="searchString" class="form-control" 
               value="@ViewData["CurrentFilter"]" placeholder="Поиск..." />
    </div>
    <div class="form-group mr-2">
        <select name="showCompleted" class="form-control">
            <option value="">Все</option>
            <option value="true">Выполненные</option>
            <option value="false">Не выполненные</option>
        </select>
    </div>
    <button type="submit" class="btn btn-primary mr-2">Фильтр</button>
    <a asp-action="Index" class="btn btn-secondary">Сбросить</a>
</form>

<!-- Таблица задач -->
<table class="table table-striped table-hover">
    <thead class="thead-dark">
        <tr>
            <th>@Html.DisplayNameFor(model => model.Title)</th>
            <th>@Html.DisplayNameFor(model => model.Description)</th>
            <th>@Html.DisplayNameFor(model => model.IsCompleted)</th>
            <th>@Html.DisplayNameFor(model => model.CreatedDate)</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Title)</td>
                <td>@Html.DisplayFor(modelItem => item.Description)</td>
                <td>
                    @if (item.IsCompleted)
                    {
                        <span class="badge badge-success">Да</span>
                    }
                    else
                    {
                        <span class="badge badge-warning">Нет</span>
                    }
                </td>
                <td>@Html.DisplayFor(modelItem => item.CreatedDate)</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-primary">Редактировать</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Удалить</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- Кнопка создания -->
<div class="mt-3">
    <a asp-action="Create" class="btn btn-success">Создать новую задачу</a>
</div>