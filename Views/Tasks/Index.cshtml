@model IEnumerable<TaskListApp.Models.TaskItem>
@{
    ViewData["Title"] = "Список задач";
}

<h1>@ViewData["Title"]</h1>

<table class="table">
    <thead>
        <tr>
            <th>Выполнено</th>  <!-- Чекбокс -->
            <th>Название</th>
            <th>Описание</th>
            <th>Действия</th>   <!-- Кнопки Удалить/Изменить -->
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr class="@(item.IsCompleted ? "table-success" : "")">
                <td class="align-middle">
                    <div class="form-check">
                        <input class="form-check-input task-checkbox" 
                               type="checkbox" 
                               data-task-id="@item.Id"
                               @(item.IsCompleted ? "checked" : "")
                               style="width: 1.2em; height: 1.2em; cursor: pointer;">
                    </div>
                </td>
                <td>@item.Title</td>
                <td>@item.Description</td>
                <td>
                    <div class="btn-group" role="group">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-primary me-1">
                            <i class="fas fa-edit"></i> Изменить
                        </a>
                        <form asp-action="Delete" method="post" onsubmit="return confirm('Удалить задачу?');">
                            <input type="hidden" name="id" value="@item.Id" />
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-danger">
                                <i class="fas fa-trash-alt"></i> Удалить
                            </button>
                        </form>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
<script>
$(document).ready(function() {
    $('.task-checkbox').change(function() {
        const taskId = $(this).data('task-id');
        const isCompleted = $(this).is(':checked');
        const row = $(this).closest('tr');
        
        $.ajax({
            url: '/Tasks/ToggleComplete',
            type: 'POST',
            data: { 
                id: taskId,
                __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
            },
            success: function() {
                // Обновляем строку
                row.toggleClass('table-success', isCompleted);
                
                // Плавная анимация
                row.css('opacity', 0.6).animate({opacity: 1}, 300);
            },
            error: function() {
                $(this).prop('checked', !isCompleted); // Возвращаем чекбокс
                alert('Ошибка при обновлении статуса');
            }
        });
    });
});
</script>
}