@model IEnumerable<TaskListApp.Models.TaskItem>
@{
    ViewData["Title"] = "Список задач";
}

<h1>@ViewData["Title"]</h1>

<table class="table">
    <thead>
        <tr>
            <th>Название</th>
            <th>Описание</th>
            <th>Статус</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr class="@(item.IsCompleted ? "table-success" : "")">
                <td>@item.Title</td>
                <td>@item.Description</td> <!-- Описание теперь точно отображается -->
                <td>
                    <div class="form-check form-switch">
                        <input class="form-check-input task-checkbox" 
                               type="checkbox" 
                               data-task-id="@item.Id"
                               @(item.IsCompleted ? "checked" : "")
                               style="transform: scale(1.5); cursor: pointer;">
                        <label class="form-check-label">
                            @(item.IsCompleted ? "Выполнено" : "В работе")
                        </label>
                    </div>
                </td>
                <td>
                    <form asp-action="Delete" method="post" onsubmit="return confirm('Удалить задачу?');">
                        <input type="hidden" name="id" value="@item.Id" />
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-danger">
                            <i class="fas fa-trash-alt"></i> Удалить
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
<script>
$(document).ready(function() {
    $('.task-checkbox').change(function() {
        const taskId = $(this).data('task-id');
        const isCompleted = $(this).is(':checked');
        const row = $(this).closest('tr');
        const label = $(this).siblings('label');
        
        $.ajax({
            url: '/Tasks/ToggleComplete',
            type: 'POST',
            data: { 
                id: taskId,
                __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
            },
            success: function() {
                // Обновляем строку
                row.toggleClass('table-success', isCompleted);
                label.text(isCompleted ? "Выполнено" : "В работе");
                
                // Плавная анимация
                row.css('opacity', 0.6).animate({opacity: 1}, 300);
            },
            error: function() {
                $(this).prop('checked', !isCompleted); // Возвращаем чекбокс
                alert('Ошибка при обновлении статуса');
            }
        });
    });
});
</script>
}